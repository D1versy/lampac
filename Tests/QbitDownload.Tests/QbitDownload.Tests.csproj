<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <LangVersion>latest</LangVersion>
    <!-- module warnings we don't want to fail on; NU1903 = transitive sqlite advisory (from Shared) -->
    <NoWarn>$(NoWarn);CS0612;NU1903;CS1998</NoWarn>
    <GenerateProgramFile>true</GenerateProgramFile>
  </PropertyGroup>

  <!-- QbitController : BaseController (ASP.NET MVC) → need the web framework to compile linked sources -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Bitmagnet.cs — в рантайме DLL приезжает из Modules/QbitDownload/references/,
         тестам нужен тот же Npgsql пакетом (версия обязана совпадать с той DLL). -->
    <PackageReference Include="Npgsql" Version="9.0.3" />
  </ItemGroup>

  <!-- TorrentHash.cs — infohash из .torrent-файла. DLL та же, что приезжает в рантайме из
       Modules/QbitDownload/references/ (вендорена в репозитории, пакетом нигде не подключена). -->
  <ItemGroup>
    <Reference Include="BencodeNET">
      <HintPath>..\..\Modules\QbitDownload\references\BencodeNET.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\Shared.csproj" />
  </ItemGroup>

  <!-- Link the dynamic-module sources so tests exercise the REAL production code
       (the module is Roslyn-compiled by the host at runtime; there is no prebuilt DLL). -->
  <ItemGroup>
    <Compile Include="..\..\Modules\QbitDownload\ModuleConf.cs" Link="Module\ModuleConf.cs" />
    <Compile Include="..\..\Modules\QbitDownload\ModInit.cs" Link="Module\ModInit.cs" />
    <Compile Include="..\..\Modules\QbitDownload\SqlContext.cs" Link="Module\SqlContext.cs" />
    <Compile Include="..\..\Modules\QbitDownload\DownloadWants.cs" Link="Module\DownloadWants.cs" />
    <Compile Include="..\..\Modules\QbitDownload\QualityUpgrade.cs" Link="Module\QualityUpgrade.cs" />
    <Compile Include="..\..\Modules\QbitDownload\JsonStore.cs" Link="Module\JsonStore.cs" />
    <Compile Include="..\..\Modules\QbitDownload\HttpCache.cs" Link="Module\HttpCache.cs" />
    <Compile Include="..\..\Modules\QbitDownload\FfWorker.cs" Link="Module\FfWorker.cs" />
    <Compile Include="..\..\Modules\QbitDownload\TorrentScoring.cs" Link="Module\TorrentScoring.cs" />
    <Compile Include="..\..\Modules\QbitDownload\EpisodeHunter.cs" Link="Module\EpisodeHunter.cs" />
    <!-- LiveTs.cs — чистая работа с байтами MPEG-TS. -->
    <Compile Include="..\..\Modules\QbitDownload\LiveTs.cs" Link="Module\LiveTs.cs" />
    <Compile Include="..\..\Modules\QbitDownload\Warmup.cs" Link="Module\Warmup.cs" />
    <Compile Include="..\..\Modules\QbitDownload\AppReplace.cs" Link="Module\AppReplace.cs" />
    <Compile Include="..\..\Modules\QbitDownload\CatalogWarmup.cs" Link="Module\CatalogWarmup.cs" />
    <Compile Include="..\..\Modules\QbitDownload\OnlineWarm.cs" Link="Module\OnlineWarm.cs" />
    <Compile Include="..\..\Modules\QbitDownload\SearchCache.cs" Link="Module\SearchCache.cs" />
    <Compile Include="..\..\Modules\QbitDownload\CubExtensions.cs" Link="Module\CubExtensions.cs" />
    <Compile Include="..\..\Modules\QbitDownload\Bitmagnet.cs" Link="Module\Bitmagnet.cs" />
    <Compile Include="..\..\Modules\QbitDownload\SearchMonitor.cs" Link="Module\SearchMonitor.cs" />
    <Compile Include="..\..\Modules\QbitDownload\HealthState.cs" Link="Module\HealthState.cs" />
    <Compile Include="..\..\Modules\QbitDownload\Health.cs" Link="Module\Health.cs" />
    <Compile Include="..\..\Modules\QbitDownload\LocalIndex.cs" Link="Module\LocalIndex.cs" />
    <Compile Include="..\..\Modules\QbitDownload\IndexCrawler.cs" Link="Module\IndexCrawler.cs" />
    <Compile Include="..\..\Modules\QbitDownload\JutSuParse.cs" Link="Module\JutSuParse.cs" />
    <Compile Include="..\..\Modules\QbitDownload\JutSuMatch.cs" Link="Module\JutSuMatch.cs" />
    <Compile Include="..\..\Modules\QbitDownload\JutSuHttp.cs" Link="Module\JutSuHttp.cs" />
    <Compile Include="..\..\Modules\QbitDownload\JutSuPoster.cs" Link="Module\JutSuPoster.cs" />
    <Compile Include="..\..\Modules\QbitDownload\JutSuPosterOptimize.cs" Link="Module\JutSuPosterOptimize.cs" />
    <Compile Include="..\..\Modules\QbitDownload\JutSu.cs" Link="Module\JutSu.cs" />
    <Compile Include="..\..\Modules\QbitDownload\JutSuStream.cs" Link="Module\JutSuStream.cs" />
    <Compile Include="..\..\Modules\QbitDownload\JutSuSegments.cs" Link="Module\JutSuSegments.cs" />
    <Compile Include="..\..\Modules\QbitDownload\JutSuHistory.cs" Link="Module\JutSuHistory.cs" />
    <Compile Include="..\..\Modules\QbitDownload\JutSuGrab.cs" Link="Module\JutSuGrab.cs" />
    <Compile Include="..\..\Modules\QbitDownload\JutSuWatch.cs" Link="Module\JutSuWatch.cs" />
    <Compile Include="..\..\Modules\QbitDownload\JutSuCatalogIndex.cs" Link="Module\JutSuCatalogIndex.cs" />
    <Compile Include="..\..\Modules\QbitDownload\Xsmart.cs" Link="Module\Xsmart.cs" />
    <Compile Include="..\..\Modules\QbitDownload\XsmartGrab.cs" Link="Module\XsmartGrab.cs" />
    <Compile Include="..\..\Modules\QbitDownload\XsmartWatch.cs" Link="Module\XsmartWatch.cs" />
    <Compile Include="..\..\Modules\QbitDownload\TorrentHash.cs" Link="Module\TorrentHash.cs" />
    <Compile Include="..\..\Modules\QbitDownload\MetaHeal.cs" Link="Module\MetaHeal.cs" />
    <Compile Include="..\..\Modules\QbitDownload\Perms.cs" Link="Module\Perms.cs" />
    <Compile Include="..\..\Modules\QbitDownload\Admin.cs" Link="Module\Admin.cs" />
    <Compile Include="..\..\Modules\QbitDownload\Controller.cs" Link="Module\Controller.cs" />
    <Compile Include="..\..\Modules\QbitDownload\Live.cs" Link="Module\Live.cs" />
    <Compile Include="..\..\Modules\QbitDownload\Replica.cs" Link="Module\Replica.cs" />
    <Compile Include="..\..\Modules\QbitDownload\ReplicaSync.cs" Link="Module\ReplicaSync.cs" />
    <Compile Include="..\..\Modules\QbitDownload\ReplicaRotate.cs" Link="Module\ReplicaRotate.cs" />
    <Compile Include="..\..\Modules\QbitDownload\ReplicaHistory.cs" Link="Module\ReplicaHistory.cs" />
    <Compile Include="..\..\Modules\QbitDownload\ReplicaNoti.cs" Link="Module\ReplicaNoti.cs" />
    <Compile Include="..\..\Modules\QbitDownload\HistoryBackfill.cs" Link="Module\HistoryBackfill.cs" />
    <Compile Include="..\..\Modules\QbitDownload\TestSandbox.cs" Link="Module\TestSandbox.cs" />


    <!-- JacRed: линкуем ТОЛЬКО ProxyFallback.cs — он намеренно не обращается ни к ModInit, ни к
         BaseController, поэтому коллизии JacRed.ModInit / QbitDownload.ModInit не возникает.
         ⚠️ Не линковать сюда GlobalUsings.cs модуля: его global using подействовал бы на ВСЮ
         тестовую сборку. -->
    <Compile Include="..\..\Modules\JacRed\Engine\ProxyFallback.cs" Link="JacRed\ProxyFallback.cs" />
    <Compile Include="..\..\Modules\JacRed\Engine\NodeRegistry.cs" Link="JacRed\NodeRegistry.cs" />

    <!-- FlareSolverr.cs — по тому же правилу: он сознательно не обращается к ModInit.conf и
         объявляет usings явно, а транспорт и часы подменяются швами Transport/Now.
         FlareSolverrConf нужен ему как аргумент и сам ни от чего не зависит. -->
    <!-- RutrackerRow.cs — только паттерны разметки строки выдачи, без ModInit и BaseController.
         Проверяются на реальном куске html: молчаливое расхождение с версткой трекера стоит
         всех его раздач сразу (см. JacRedRutrackerRowTests). -->
    <Compile Include="..\..\Modules\JacRed\Engine\RutrackerRow.cs" Link="JacRed\RutrackerRow.cs" />
    <Compile Include="..\..\Modules\JacRed\Engine\FlareSolverr.cs" Link="JacRed\FlareSolverr.cs" />
    <Compile Include="..\..\Modules\JacRed\Models\AppConf\FlareSolverrConf.cs" Link="JacRed\FlareSolverrConf.cs" />

    <!-- Online: линкуем ТОЛЬКО OnlineEventsCache.cs — он не трогает ни Online.ModInit, ни
         BaseController, поэтому коллизии с QbitDownload.ModInit не возникает. Под тестами его
         два инварианта: «пишем только полный набор» и «не закрепляем массовый сбой». -->
    <Compile Include="..\..\Online\OnlineEventsCache.cs" Link="Online\OnlineEventsCache.cs" />

    <!-- D1VPerimeter.cs — весь внешний периметр D1Vision. Зависит только от AspNetCore.Http +
         Shared (RequestModel/CoreInit) + Serilog — всё уже подключено FrameworkReference’ом и ProjectReference’ом.
         Тесты гоняют Invoke() на DefaultHttpContext, без подъёма Startup. -->
    <Compile Include="..\..\Core\Middlewares\D1VPerimeter.cs" Link="Core\D1VPerimeter.cs" />
  </ItemGroup>

</Project>
